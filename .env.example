# --- Database (Turso / libSQL) ---
# ローカル開発はファイルDBでOK。本番は Turso の URL とトークンを設定
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# --- Better-Auth ---
# openssl rand -base64 32 などで生成
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth（未設定ならGoogleログインは無効） ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Resend（未設定ならメールはコンソールに出力） ---
RESEND_API_KEY=
EMAIL_FROM="Video Platform <noreply@example.com>"

# --- Stripe（テストモードのキーを使う） ---
# ダッシュボード → 開発者 → APIキー の「シークレットキー」(sk_test_...)
STRIPE_SECRET_KEY=
# `stripe listen` の表示する whsec_...（コマンドは README 参照）
STRIPE_WEBHOOK_SECRET=
